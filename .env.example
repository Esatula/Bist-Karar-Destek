# .env dosyası şablonu
# Bu dosyayı ".env" olarak kopyalayıp gerçek anahtarlarınızı girin.
# .env dosyası asla Git'e gönderilmez (.gitignore'a eklidir).

# Google Gemini API Anahtarı (yeni SDK: google-genai)
# Anahtar almak için: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Opsiyonel: Ollama yerel model (ileride kullanım için)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
